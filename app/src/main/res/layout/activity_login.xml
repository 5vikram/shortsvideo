<?xml version="1.0" encoding="utf-8"?>
<androidx.appcompat.widget.LinearLayoutCompat xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    tools:context=".LoginActivity">

    <androidx.appcompat.widget.LinearLayoutCompat
        android:id="@+id/toolbarLayout"
        android:layout_width="match_parent"
        android:layout_height="50dp"
        android:orientation="horizontal"
        app:layout_constraintTop_toTopOf="parent">

        <androidx.appcompat.widget.AppCompatImageView
            android:id="@+id/loginBackButton"
            android:layout_width="@dimen/_40sdp"
            android:layout_height="@dimen/_25sdp"
            android:layout_gravity="center_vertical"
            android:layout_marginStart="10dp"
            android:adjustViewBounds="true"
            android:clickable="true"
            android:focusable="true"
            android:onClick="onClick"
            android:padding="5dp"
            app:srcCompat="@drawable/back_button" />


        <ImageView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center_vertical"
            android:layout_marginStart="@dimen/_10sdp"
            android:layout_marginEnd="16dp"
            android:scaleType="fitXY"
            android:src="@mipmap/toolbar_icon" />

    </androidx.appcompat.widget.LinearLayoutCompat>



    <com.multitv.ott.shortvideo.utils.CustomTabLayout
        android:id="@+id/tabLayoutWatchList"
        style="@style/MyTabLayout"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginLeft="@dimen/_10sdp"
        android:layout_marginRight="@dimen/_10sdp"
        android:layout_marginTop="@dimen/_30sdp"
        android:background="@android:color/transparent"
        app:tabBackground="@drawable/tab_indicator_color"
        app:tabIndicator="@color/gray"
        android:layout_gravity="center_horizontal"
        app:tabGravity="center"
        app:tabIndicatorColor="@color/red"
        app:tabIndicatorHeight="@dimen/_1sdp"
        app:tabMode="fixed" />

    <androidx.viewpager.widget.ViewPager
        android:id="@+id/viewPagerWatchList"
        android:layout_width="match_parent"
        android:layout_height="match_parent" />






</androidx.appcompat.widget.LinearLayoutCompat>